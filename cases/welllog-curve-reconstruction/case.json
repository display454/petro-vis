          "默认遮挡",
          "75 / 500"
        ],
        [
          "块长上限",
          "15 点"
        ],
        [
          "默认 λ",
          "10"
        ]
      ],
      "steps": [
        {
          "name": "固定观测数据",
          "role": "数据",
          "do": "只读 v2，确认目标 GR 与三条辅助曲线等长。",
          "effect": "标签与修复无关。",
          "trap": "不能把 NPHI 当作 GR 真值。"
        },
        {
          "name": "训练跨曲线模型",
          "role": "训练",
          "do": "四井 2000 个完整样本，拟合训练统计及岭回归系数。",
          "effect": "保存训练井和 λ。",
          "trap": "测试井不参与拟合。"
        },
        {
          "name": "生成遮罩与可见输入",
          "role": "遮挡",
          "do": "只对有效 GR 遮挡；保留锚点；同 seed 和比例可复现。",
          "effect": "输出 flags、gapKind、visible。",
          "trap": "未遮掉真值不能传给 repairCurve。"
        },
        {
          "name": "同区独立重建",
          "role": "算法",
          "do": "插值只读 visible GR，岭回归只读三条辅助曲线。",
          "effect": "各自返回 filled 与参数。",
          "trap": "不能拿一种方法的结果做另一种方法输入。"
        },
        {
          "name": "评价与共同点比较",
          "role": "评价",
          "do": "只计 flags=true 且有真值的点，另报预测覆盖率。",
          "effect": "共同可预测点上的差异可公平比较。",
          "trap": "未预测点不能假记 0 误差。"
        },
        {
          "name": "查看残差与缺口",
          "role": "人工",
          "do": "定位曲线、缺口带和局部残差，切显示不重生成遮罩。",
          "effect": "理解局部尖峰和跨井失配。",
          "trap": "原生缺口不显示误差或“修复成功率”。"
        }
      ],
      "metrics": {
        "title": "从遮罩到评价的可复核约定",
        "html": "<figure style=\"margin:20px 0\"><div style=\"overflow-x:auto;border:1px solid var(--line,#d9dcd1)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"220\" viewBox=\"0 0 900 220\" role=\"img\" aria-label=\"六步数据流\" style=\"display:block;max-width:none;background:#fffefa;font-family:Microsoft YaHei,Segoe UI,sans-serif\"><title>六步数据流</title><rect x=\"25\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"37\" y=\"99\" font-size=\"14\" fill=\"#263a35\">1. 固定拆井</text><text x=\"159\" y=\"109\" font-size=\"16\" fill=\"#263a35\">→</text><rect x=\"171\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"183\" y=\"99\" font-size=\"14\" fill=\"#263a35\">2. 训练统计</text><text x=\"305\" y=\"109\" font-size=\"16\" fill=\"#263a35\">→</text><rect x=\"317\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"329\" y=\"99\" font-size=\"14\" fill=\"#263a35\">3. 生成遮罩</text><text x=\"451\" y=\"109\" font-size=\"16\" fill=\"#263a35\">→</text><rect x=\"463\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"475\" y=\"99\" font-size=\"14\" fill=\"#263a35\">4. 独立修复</text><text x=\"597\" y=\"109\" font-size=\"16\" fill=\"#263a35\">→</text><rect x=\"609\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"621\" y=\"99\" font-size=\"14\" fill=\"#263a35\">5. 仅遮挡评</text><text x=\"743\" y=\"109\" font-size=\"16\" fill=\"#263a35\">→</text><rect x=\"755\" y=\"68\" width=\"132\" height=\"70\" fill=\"#e5ece2\"/><text x=\"767\" y=\"99\" font-size=\"14\" fill=\"#263a35\">6. 人工复核</text><text x=\"28\" y=\"35\" font-size=\"16\" fill=\"#263a35\">数据和答案分开保存，评价在预测之后执行</text><text x=\"28\" y=\"191\" font-size=\"14\" fill=\"#59675f\">原始 GR 仅保存在评价端；visible.gr_api 的遮挡点必须为 null。</text></svg></div><figcaption style=\"font-size:14px;color:var(--ink-2,#59675f);padding-top:8px\">图 4 · 六步数据流（固定配置实际计算，小屏可横向查看）</figcaption></figure><figure style=\"margin:20px 0\"><div style=\"overflow-x:auto;border:1px solid var(--line,#d9dcd1)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"320\" viewBox=\"0 0 900 320\" role=\"img\" aria-label=\"遮罩规则与输入隔离\" style=\"display:block;max-width:none;background:#fffefa;font-family:Microsoft YaHei,Segoe UI,sans-serif\"><title>遮罩规则与输入隔离</title><text x=\"25\" y=\"30\" font-size=\"14\" fill=\"#263a35\">遮罩只看可用性、深度和固定哈希顺序，不看被遮住的值</text><rect x=\"27\" y=\"80\" width=\"18\" height=\"38\" fill=\"#758a78\"/><rect x=\"48\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"69\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"90\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"111\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"132\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"153\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"174\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"195\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"216\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"237\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"258\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"279\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"300\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"321\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"342\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"363\" y=\"80\" width=\"18\" height=\"38\" fill=\"#758a78\"/><rect x=\"384\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"405\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"426\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"447\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"468\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"489\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"510\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"531\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"552\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"573\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"594\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"615\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"636\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"657\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"678\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"699\" y=\"80\" width=\"18\" height=\"38\" fill=\"#758a78\"/><rect x=\"720\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"741\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"762\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"783\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"804\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"825\" y=\"80\" width=\"18\" height=\"38\" fill=\"#eadbc2\"/><rect x=\"846\" y=\"80\" width=\"18\" height=\"38\" fill=\"#758a78\"/><text x=\"25\" y=\"151\" font-size=\"14\" fill=\"#263a35\">保留段首段尾和块间锚点；每块最多 15 点，比例升高沿同一顺序增加点。</text><text x=\"25\" y=\"192\" font-size=\"14\" fill=\"#263a35\">原始目标 → flags / gapKind → visible.gr_api[masked] = null → 两种方法分别修复</text><text x=\"25\" y=\"234\" font-size=\"14\" fill=\"#263a35\">evaluateRepair 单独拿原始观测；repairCurve 收到未遮掉的真值会直接报错。</text><text x=\"25\" y=\"284\" font-size=\"14\" fill=\"#59675f\">原生 null 不进入遮罩、不进指标；若方法无预测则 n_eval 下降，覆盖率必须同时展示。</text></svg></div><figcaption style=\"font-size:14px;color:var(--ink-2,#59675f);padding-top:8px\">图 5 · 遮罩规则与输入隔离（固定配置实际计算，小屏可横向查看）</figcaption></figure><figure style=\"margin:20px 0\"><div style=\"overflow-x:auto;border:1px solid var(--line,#d9dcd1)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"900\" height=\"320\" viewBox=\"0 0 900 320\" role=\"img\" aria-label=\"验证参数选择\" style=\"display:block;max-width:none;background:#fffefa;font-family:Microsoft YaHei,Segoe UI,sans-serif\"><title>验证参数选择</title><text x=\"25\" y=\"30\" font-size=\"14\" fill=\"#263a35\">只用验证井 75 个遮挡点选择 λ；测试井不参与</text><text x=\"25\" y=\"84\" font-size=\"14\" fill=\"#263a35\">λ = 0.001</text><rect x=\"145\" y=\"66\" width=\"459.8083833125903\" height=\"24\" fill=\"#63816b\"/><text x=\"660\" y=\"84\" font-size=\"14\" fill=\"#263a35\">28.74 API MAE</text><text x=\"25\" y=\"123\" font-size=\"14\" fill=\"#263a35\">λ = 0.01</text><rect x=\"145\" y=\"105\" width=\"456.29604912199795\" height=\"24\" fill=\"#63816b\"/><text x=\"660\" y=\"123\" font-size=\"14\" fill=\"#263a35\">28.52 API MAE</text><text x=\"25\" y=\"162\" font-size=\"14\" fill=\"#263a35\">λ = 0.1</text><rect x=\"145\" y=\"144\" width=\"429.55315484177595\" height=\"24\" fill=\"#63816b\"/><text x=\"660\" y=\"162\" font-size=\"14\" fill=\"#263a35\">26.85 API MAE</text><text x=\"25\" y=\"201\" font-size=\"14\" fill=\"#263a35\">λ = 1</text><rect x=\"145\" y=\"183\" width=\"373.6369451618607\" height=\"24\" fill=\"#63816b\"/><text x=\"660\" y=\"201\" font-size=\"14\" fill=\"#263a35\">23.35 API MAE</text><text x=\"25\" y=\"240\" font-size=\"14\" fill=\"#263a35\">λ = 10</text><rect x=\"145\" y=\"222\" width=\"364.9382423295602\" height=\"24\" fill=\"#63816b\"/><text x=\"660\" y=\"240\" font-size=\"14\" fill=\"#263a35\">22.81 API MAE</text><text x=\"25\" y=\"303\" font-size=\"14\" fill=\"#a45d36\">冻结 λ=10；验证插值 MAE 10.55 API，低于岭回归的 22.81 API。</text></svg></div><figcaption style=\"font-size:14px;color:var(--ink-2,#59675f);padding-top:8px\">图 6 · 验证参数选择（固定配置实际计算，小屏可横向查看）</figcaption></figure><p>MAE 与 RMSE 仅在成功预测的遮挡点计算，并报告 n_eval / n_masked。R²=1−SSE/SST，真值方差为零时不适用。两法比较用 compareRepairs 的共同点，不把不同覆盖范围的指标直接作差。</p>"
      },
      "fails": [
        {
          "name": "段首段尾没有插值锚点",
          "why": "插值返回 null，不能无声外推。"
        },
        {
          "name": "辅助曲线也缺失",
          "why": "岭回归该点返回 null，覆盖率随之下降。"
        },
        {
          "name": "跨井关系偏移",
          "why": "固定训练模型可能不如局部插值。"
        },
        {
          "name": "原生缺口没有答案",
          "why": "可展示估计值，但不能计算误差或宣称准确。"
        }
      ]
    },
    "demo": {
      "mode": "auto",
      "html": "demo/index.html",
      "label": "可运行示范",
      "height": 1000,
      "intro": "默认验证井，目标固定 GR。固定遮罩，两法独立重建；曲线、缺口与残差联动，测试模型 λ=10 冻结。"
    }
  }
}
