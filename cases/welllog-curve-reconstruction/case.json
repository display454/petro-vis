        {
          "label": "任务",
          "value": "GR 重建",
          "desc": "只修复目标曲线，不改其他通道"
        },
        {
          "label": "对照",
          "value": "两种独立方法",
          "desc": "深度插值 / 跨曲线岭回归"
        },
        {
          "label": "评价",
          "value": "仅遮挡点",
          "desc": "MAE / RMSE / R² 与覆盖率"
        },
