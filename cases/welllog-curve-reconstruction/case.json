-dasharray=\"2 2\"/><line x1=\"812.6\" y1=\"155\" x2=\"812.6\" y2=\"155.4562288329702\" stroke=\"#a45d36\" stroke-dasharray=\"\"/><line x1=\"816.6\" y1=\"155\" x2=\"816.6\" y2=\"148.28461490610306\" stroke=\"#256754\" stroke-dasharray=\"2 2\"/><line x1=\"823.4000000000001\" y1=\"155\" x2=\"823.4000000000001\" y2=\"154.58661213012888\" stroke=\"#a45d36\" stroke-dasharray=\"\"/><line x1=\"827.4000000000001\" y1=\"155\" x2=\"827.4000000000001\" y2=\"147.17501957451097\" stroke=\"#256754\" stroke-dasharray=\"2 2\"/><line x1=\"834.2\" y1=\"155\" x2=\"834.2\" y2=\"154.5021328964009\" stroke=\"#a45d36\" stroke-dasharray=\"\"/><line x1=\"838.2\" y1=\"155\" x2=\"838.2\" y2=\"146.77786841942742\" stroke=\"#256754\" stroke-dasharray=\"2 2\"/><text x=\"25\" y=\"282\" font-size=\"14\" fill=\"#263a35\">铜色实线=插值；绿色点线=岭回归。插值在 50 点更接近，岭回归在 25 点更接近。</text><text x=\"25\" y=\"307\" font-size=\"14\" fill=\"#59675f\">少量大误差会改变 MAE/RMSE 的结论；逐点胜出次数不能替代总体误差。</text></svg></div><figcaption style=\"font-size:14px;color:var(--ink-2,#59675f);padding-top:8px\">图 2 · 同区残差揭示总体分数背后的差异（固定配置实际计算，小屏可横向查看）</figcaption></figure>"
